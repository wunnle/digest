        {
          "published_at": "2026-10-15T03:54:23.185Z",
          "url": "https://x.com/thorstenball/status/2110580016140431681",
          "topic": "Simpler context management with newer coding models",
          "text": "With the latest models, I don't think stuff like /btw and forking and all the other context management makes sense anymore.\n\nThey are now so good at following instructions that you can literally ask side-questions in the same thread, they get steered in, model answers and then continues.",
          "quote_tweet": null,
          "author_replies": [],
          "render_audit": {
            "root_article_url": "https://x.com/thorstenball/status/2110580016140431681",
