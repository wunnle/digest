        {
          "published_at": "2026-11-12T16:31:00Z",
          "url": "https://x.com/thorstenball/status/2120917288366829695",
          "topic": "AI-assisted development velocity",
          "text": "Showed an earlier version of this chart in a talk a month ago and said: look at our velocity!\n\nNow I recreated the chart and wow\n\n(Same headcount.)",
          "quote_tweet": null,
          "author_replies": [],
          "render_audit": {
            "root_article_url": "https://x.com/thorstenball/status/2120917288366829695",
            "inspected_at": "2026-11-13T04:08:00Z",
            "quote_card": {
